{
    "name": "buscador-ir/indexacion",
    "description": "Modulo de indizacion y busqueda con similitud coseno y tf-idf",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "suggest": {
        "ext-intl": "Permite normalizar texto (quitar diacriticos) de forma robusta"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
