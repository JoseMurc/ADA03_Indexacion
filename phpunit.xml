<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Indexing">
            <directory>tests/Indexing</directory>
        </testsuite>
        <testsuite name="Search">
            <directory>tests/Search</directory>
        </testsuite>
        <testsuite name="Storage">
            <directory>tests/Storage</directory>
        </testsuite>
        <testsuite name="EndToEnd">
            <directory>tests/EndToEnd</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
